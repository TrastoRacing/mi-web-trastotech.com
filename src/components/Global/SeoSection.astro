---
const { title, description, keywords, robots, locale, url, imageUrl, imageWidth, imageHeight, headTitle } =
    Astro.props

const siteTitle = headTitle ? `TrastoTech | ${headTitle}`: 'TrastoTech - Profesional de TI';
---

<title>{siteTitle}</title>

<meta name="description" content={description} />
<meta name="author" content="Antonio Sancho" />
<meta name="keywords" content={keywords} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<meta name="google" content="nositelinkssearchbox" />
<meta name="google" content="notranslate" />

<meta property="og:locale" content={locale} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:site_name" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
