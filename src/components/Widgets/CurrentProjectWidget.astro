---
import Pill from "../Global/Pill.astro";
---
<section class="md:col-span-2 xl:col-span-2 bg-gray-900 border border-gray-800 rounded-2xl shadow-lg shadow-cyan-400/10 p-6">
    <h3 class="text-white text-lg font-semibold mb-4">Proyecto Actual</h3>

    <div class="grid md:grid-cols-1 gap-4">
        <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-4">
            <div class="flex items-center mb-2">
                <div class="w-3 h-3 bg-green-400 rounded-full mr-2"></div>
                <span class="text-blue-400 font-medium">SaaS Dashboard</span>
            </div>

            <p class="text-gray-400 text-sm mb-3">Dashboard analítico para gestión de datos empresariales con visualizaciones en tiempo real.</p>

            <div class="flex flex-wrap gap-1">
                <Pill bgColor="cyan-400" textColor="cyan-400">Vue.js</Pill>
                <Pill bgColor="purple-500" textColor="purple-400">Python</Pill>
                <Pill bgColor="blue-500" textColor="blue-400">PostgreSQL</Pill>
            </div>
        </div>
    </div>
</section>
