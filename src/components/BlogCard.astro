---
import {Image} from "astro:assets";

import type {ImageMetadata} from "astro";

type Props = {
    title: string;
    description: string;
    slug: string;
    image?: ImageMetadata
}

const { title, description, slug, image } = Astro.props;

const viewMoreHref = `/blog/${slug}/`
---

<div class="bg-gray-900 shadow-lg shadow-cyan-400/10 rounded-2xl border border-gray-800 p-6 max-w-md mx-auto transition transform hover:-translate-y-1 hover:shadow-cyan-400/20">
    <div class="flex justify-center mb-4">
        {image && (
                <Image width={720} height={360} src={image} alt={ title } />
        )}
    </div>

    <h2 class="text-white text-2xl font-semibold mb-2 text-center">{ title }</h2>

    <p class="text-gray-400 text-center mb-4">{ description }</p>

    <div class="flex justify-center">
        <a href={viewMoreHref} class="bg-blue-500 hover:bg-cyan-400 text-white font-medium px-6 py-2 rounded-md transition-colors duration-300">
            Ver más
        </a>
    </div>
</div>
