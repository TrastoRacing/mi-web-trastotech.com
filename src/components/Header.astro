---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface HeaderLink {
    href: string;
    title: string;
}

const navLinks: HeaderLink[] = [
    {
      href: '/',
      title: 'Inicio',
    },
    {
        href: '/blog',
        title: 'Blog'
    }
]
---

<header class="p-6 fixed top-0 left-0 z-50 w-full">
	<nav class="flex content-center justify-between gap-2 p-4 rounded-3xl bg-indigo-200/60 shadow-md backdrop-blur-xs">
		<h2 class="font-bold text-2xl">
            {SITE_TITLE}
        </h2>

		<div class="flex content-center gap-4">
            {
                navLinks.map(({href, title}) => (
                    <HeaderLink href={href}>{ title }</HeaderLink>
                ))
            }
		</div>
	</nav>
</header>
