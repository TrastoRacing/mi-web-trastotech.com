---
import GithubIcon from "./GithubIcon.astro";
import LinkedinIcon from "./LinkedInIcon.astro";

import Logo from "./Logo.astro";
const today = new Date();
---

<footer class="bg-gray-900 border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
            <div class="flex items-center mb-4 md:mb-0">
                <Logo />
            </div>

            <div class="flex space-x-4">
                <a href="https://github.com/TrastoRacing" target="_blank" class="text-gray-400 hover:text-cyan-400 transition-colors duration-300">
                    <GithubIcon />
                </a>

                <a href="#" target="_blank" class="text-gray-400 hover:text-cyan-400 transition-colors duration-300">
                    <LinkedinIcon />
                </a>
            </div>
        </div>

        <!-- Copyright -->
        <div class="border-t border-gray-800 mt-6 pt-6 text-center">
            <p class="text-gray-400 text-sm">&copy; {today.getFullYear()} by Trasto. Todos los derechos reservados.</p>
        </div>
    </div>
</footer>
