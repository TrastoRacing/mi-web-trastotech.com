---
import FormattedDate from '../components/FormattedDate.astro';

import { getPostSortedByDate } from "../helpers/blogHelper";

type Props = {
    count?: number
}

const { count } = Astro.props;

const maxResults = count || 3;

const posts = (await getPostSortedByDate()).slice(0, maxResults);
---

<section class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg shadow-cyan-400/10 p-6">
    <h3 class="text-white text-lg font-semibold mb-4">Blog reciente</h3>

    <div class="space-y-4">
        {
            posts.map(({ data: { title, description, pubDate } }) => (
                <div class="border-l-4 border-cyan-400 pl-3">
                    <h4 class="text-cyan-400 text-sm font-medium">{ title }</h4>
                    <p class="text-gray-400 text-xs">{ description }</p>

                    <span class="text-gray-500 text-xs">
                         <FormattedDate date={ pubDate } />
                    </span>
                </div>
            ))
        }
    </div>
</section>
