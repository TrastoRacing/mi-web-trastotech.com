---
import { Image } from 'astro:assets';

import PageLayout from "../layouts/PageLayout.astro";

import profileImage from '../assets/profile.jpg';
import LatestPostsWidget from "../components/LatestPostsWidget.astro";
---
<PageLayout>
    <div class="bg-gray-900 py-12 px-4">
        <div class="max-w-7xl mx-auto">
            <!-- Bento Grid Container -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 auto-rows-auto">

                <!-- Card 1: Presentación Principal (Grande) -->
                <section class="md:col-span-2 lg:col-span-2 lg:row-span-2 bg-gradient-to-br from-gray-900 via-blue-900/20 to-cyan-900/20 border border-gray-800 rounded-2xl shadow-lg shadow-cyan-400/10 p-8">
                    <div class="flex items-center mb-6">
                        <div>
                            <h1 class="text-white text-2xl font-bold">Antonio Sancho Valencia</h1>

                            <p class="text-cyan-400 font-medium">Técnico de sistemas</p>
                        </div>
                    </div>

                    <p class="text-gray-200 text-lg leading-relaxed mb-6">
                        Especializada en crear experiencias digitales modernas, escalables y centradas en el usuario. Apasionada por las tecnologías web emergentes y el diseño funcional.
                    </p>

                    <div class="flex flex-wrap gap-2">
                        <span class="bg-cyan-400/10 text-cyan-400 text-xs px-3 py-1 rounded-full">5+ años experiencia</span>
                        <span class="bg-blue-500/10 text-blue-400 text-xs px-3 py-1 rounded-full">15+ proyectos</span>
                        <span class="bg-green-400/10 text-green-400 text-xs px-3 py-1 rounded-full">Freelance disponible</span>
                    </div>
                </section>

                <!-- Card 3: Img -->
                <section class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg shadow-cyan-400/10">
                    <Image class="rounded-2xl" width={800} height={800} alt="ttt" src={profileImage} />
                </section>

                <!-- Card 2: Stack Tecnológico -->
                <section class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg shadow-cyan-400/10 p-6">
                    <div class="flex items-center mb-4">
                        <div class="bg-cyan-400/10 p-2 rounded-lg mr-3">
                            <svg class="w-6 h-6 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V7l-10-5z"/>
                            </svg>
                        </div>

                        <h3 class="text-white text-lg font-semibold">Tech Stack</h3>
                    </div>
                    <div class="grid grid-cols-2 gap-3 text-sm">
                        <div class="text-gray-300">
                            <div class="text-cyan-400 font-medium">Frontend</div>
                            <div>React, Vue.js</div>
                            <div>Tailwind, SCSS</div>
                        </div>

                        <div class="text-gray-300">
                            <div class="text-cyan-400 font-medium">Backend</div>
                            <div>Node.js, Python</div>
                            <div>MongoDB, PostgreSQL</div>
                        </div>
                    </div>
                </section>

                <!-- Card 4: Proyectos Destacados (Ancho) -->
                <section class="md:col-span-2 lg:col-span-2 bg-gray-900 border border-gray-800 rounded-2xl shadow-lg shadow-cyan-400/10 p-6">
                    <h3 class="text-white text-lg font-semibold mb-4">Proyecto Actual</h3>

                    <div class="grid md:grid-cols-1 gap-4">
                        <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-4">
                            <div class="flex items-center mb-2">
                                <div class="w-3 h-3 bg-green-400 rounded-full mr-2"></div>
                                <span class="text-blue-400 font-medium">SaaS Dashboard</span>
                            </div>

                            <p class="text-gray-400 text-sm mb-3">Dashboard analítico para gestión de datos empresariales con visualizaciones en tiempo real.</p>

                            <div class="flex flex-wrap gap-1">
                                <span class="bg-cyan-400/10 text-cyan-400 text-xs px-2 py-1 rounded">Vue.js</span>
                                <span class="bg-purple-500/10 text-purple-400 text-xs px-2 py-1 rounded">Python</span>
                                <span class="bg-blue-500/10 text-blue-400 text-xs px-2 py-1 rounded">PostgreSQL</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Card 5: Ubicación y Disponibilidad -->
                <section class="bg-gray-900 border border-gray-800 rounded-2xl shadow-lg shadow-cyan-400/10 p-6">
                    <div class="flex items-center mb-4">
                        <div class="bg-green-400/10 p-2 rounded-lg mr-3">
                            <div class="w-3 h-3 bg-green-400 rounded-full animate-pulse"></div>
                        </div>

                        <h3 class="text-white text-lg font-semibold">Disponibilidad</h3>
                    </div>

                    <div class="space-y-3">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-gray-400 mr-2" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                            </svg>

                            <span class="text-gray-300 text-sm">Madrid, España</span>
                        </div>

                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-gray-400 mr-2" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>

                            <span class="text-gray-300 text-sm">Trabajo remoto</span>
                        </div>

                        <div class="bg-green-400/10 border border-green-400/20 rounded-lg p-3 mt-4">
                            <p class="text-green-400 text-sm font-medium">Disponible para nuevos proyectos</p>
                            <p class="text-gray-400 text-xs mt-1">Respuesta en menos de 24h</p>
                        </div>
                    </div>
                </section>

                <LatestPostsWidget />

                <!-- Card 7: Contacto CTA -->
                <section class="md:col-span-1 lg:col-span-2 bg-gradient-to-r from-cyan-400/10 to-blue-500/10 border border-cyan-400/20 rounded-2xl shadow-lg shadow-cyan-400/20 p-6">
                    <h3 class="text-white text-xl font-bold mb-3">¿Hablamos?</h3>

                    <p class="text-gray-300 mb-6">
                        Si tienes una idea, proyecto o simplemente quieres conectar, estaré encantada de escucharte. Siempre abierta a nuevas oportunidades y colaboraciones.
                    </p>

                    <div class="flex flex-wrap gap-3">
                        <a href="mailto:ana@email.com" class="bg-cyan-400 hover:bg-cyan-300 text-gray-900 px-6 py-3 rounded-lg font-semibold transition-colors duration-300">
                            Enviar email
                        </a>

                        <a href="#" class="border border-cyan-400 text-cyan-400 hover:bg-cyan-400 hover:text-gray-900 px-6 py-3 rounded-lg font-semibold transition-all duration-300">
                            LinkedIn
                        </a>

                        <a href="#" class="border border-blue-500 text-blue-400 hover:bg-blue-500 hover:text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300">
                            GitHub
                        </a>
                    </div>
                </section>
            </div>
        </div>
    </div>
</PageLayout>
