---
import {getPostSortedByDate} from "../../helpers/blogHelper";


import BlogLayout from "../../layouts/BlogLayout.astro";
import BlogCard from "../../components/BlogCard.astro";

const posts = await getPostSortedByDate();
---
<BlogLayout>
    {
        posts.map((post) => (
            <BlogCard title={ post.data.title } description={ post.data.description } slug={post.id} image={post.data.heroImage} />
        ))
    }
</BlogLayout>

